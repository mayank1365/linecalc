#!/bin/sh
# LCB/1 static file server.  usage: ./bserve <document-root> [port]   (default 9000)
set -e
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -d "$dir/target/classes" ]; then
  echo "build first:  mvn -q package" >&2
  exit 2
fi
exec java -cp "$dir/target/classes" linecalc.server.BinaryServer "$@"
